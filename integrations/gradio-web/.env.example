# bitHuman Web UI (Gradio + FastRTC)
# Copy this file: cp .env.example .env

# ── Required ─────────────────────────────────────────────────
# Read by app.py on the server only; it is never sent to the browser.
BITHUMAN_API_SECRET=your_api_secret_here    # www.bithuman.ai > Developer > API Secrets
OPENAI_API_KEY=sk-your_openai_key_here      # For AI conversation (OpenAI Realtime API)

# ── Optional ─────────────────────────────────────────────────
# Folder with .imx avatar files. Default: ~/.cache/bithuman/examples; if it has
# none, the public wise-pup sample (Expression 2, ~190 MB) is downloaded there once.
# BITHUMAN_MODEL_ROOT=/path/to/models
