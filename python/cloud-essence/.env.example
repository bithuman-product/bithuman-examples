# bitHuman Essence Cloud
# Copy this file: cp .env.example .env

# ── Required ─────────────────────────────────────────────────
# Your API secret, from www.bithuman.ai/developer/api-keys. The worker uses it for one thing:
# minting a one-hour token that can start only this agent's avatar in one room; only that token
# reaches the room. Never name it BITHUMAN_API_SECRET here: livekit-plugins-bithuman (1.8.4 and
# older) reads that name by itself and copies it into the avatar's participant attributes, which
# everyone in the room can read. agent.py refuses to start while BITHUMAN_API_SECRET is set.
BITHUMAN_MASTER_SECRET=your_api_secret_here
# Your agent code from www.bithuman.ai, or the public sample A23WJF0199 (wise-pup).
# (BITHUMAN_AGENT_CODE is accepted as another name for the same thing.)
BITHUMAN_AGENT_ID=A23WJF0199
# For AI conversation (agent.py)
OPENAI_API_KEY=sk-your_openai_key_here

# The local LiveKit server's secret — any long random string, e.g. `openssl rand -hex 32`.
# docker-compose.yml hands it to the server, the agent and the web UI.
LIVEKIT_API_SECRET=

# ── Optional ─────────────────────────────────────────────────
# AI persona -- controls how the avatar responds in conversation
# AGENT_PROMPT="You are a helpful assistant. Respond concisely."
# OpenAI TTS voice
OPENAI_VOICE=coral

# ── Networking (usually no changes needed) ───────────────────
# LiveKit advertises this IP in WebRTC candidates. Default 127.0.0.1
# works for localhost and SSH tunnel. For direct public access
# (no SSH tunnel), set to your VPS public IP:
# NODE_IP=203.0.113.1
