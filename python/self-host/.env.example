# Copy to .env and fill in the two secrets. Never pass secrets on the command line.

# Your API secret, www.bithuman.ai/developer/api-keys — required for both models.
# Never name it BITHUMAN_API_SECRET in a LiveKit worker: livekit-plugins-bithuman (1.8.4 and older)
# reads that name by itself and, for a cloud avatar, copies it into participant attributes that
# everyone in the room can read. agent.py passes it to the plugin explicitly and refuses to start
# while BITHUMAN_API_SECRET is set.
BITHUMAN_MASTER_SECRET=
# platform.openai.com — OpenAI Realtime does the listening, thinking and speaking
OPENAI_API_KEY=

# wise-pup = Expression 2 · sofia-ramirez = Essence 2 · or your agent code · or a path to an avatar file
BITHUMAN_AVATAR=wise-pup
BITHUMAN_REALTIME_MODEL=gpt-realtime-2.1-mini
# any OpenAI Realtime voice
BITHUMAN_VOICE=coral
BITHUMAN_INSTRUCTIONS=You are a friendly assistant. Keep answers short.

# livekit-server --dev
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
